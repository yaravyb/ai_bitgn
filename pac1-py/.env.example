# =============================================================================
# BitGN PAC1 Agent -- LiteLLM Model Configuration
# =============================================================================
#
# This agent uses LiteLLM for provider-agnostic LLM access.
# Model identifiers use the format: provider/model-name
#
# Supported LiteLLM provider prefixes:
#   openai/       -- OpenAI (requires OPENAI_API_KEY)
#   anthropic/    -- Anthropic direct API (requires ANTHROPIC_API_KEY)
#   bedrock/      -- AWS Bedrock (requires AWS credentials)
#   azure/        -- Azure OpenAI (requires AZURE_API_KEY, AZURE_API_BASE)
#   vertex_ai/    -- Google Vertex AI (requires GOOGLE_APPLICATION_CREDENTIALS)
#
# Example model identifiers:
#   openai/gpt-4.1                                   -- OpenAI GPT-4.1
#   openai/gpt-4.1-mini                              -- OpenAI GPT-4.1 Mini
#   anthropic/claude-sonnet-4-6                       -- Anthropic Claude Sonnet
#   bedrock/us.anthropic.claude-sonnet-4-5-v2:0       -- AWS Bedrock Claude
#
# =============================================================================

# Model selection
# MODEL_ID=openai/gpt-4.1-2025-04-14

# =============================================================================
# Provider API Keys (set the keys for your chosen provider)
# =============================================================================

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# AWS Bedrock (uses standard AWS credential chain)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# Custom OpenAI-compatible endpoint (optional)
# =============================================================================
# Route all LLM calls to a self-hosted or custom endpoint.
# LLM_API_BASE=https://your-endpoint.com/v1
# LLM_API_KEY=your-key

# =============================================================================
# BitGN Harness
# =============================================================================

# BENCHMARK_HOST=https://api.bitgn.com
# BENCHMARK_ID=bitgn/pac1-dev

# =============================================================================
# Observability (optional -- Langfuse)
# =============================================================================
# Set these to enable automatic LLM call tracing via Langfuse.
# Install with: uv sync --group observability
# When unset, the agent runs with zero observability overhead.
#
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com  # or self-hosted URL
# SESSION_ID=                                # optional: groups multiple task runs
