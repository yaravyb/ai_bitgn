# =============================================================================
# BitGN Sandbox Agent -- LiteLLM Model Configuration
# =============================================================================
#
# This agent uses LiteLLM for provider-agnostic LLM access.
# Model identifiers use the format: provider/model-name
#
# Supported LiteLLM provider prefixes:
#   openai/       -- OpenAI (requires OPENAI_API_KEY)
#   anthropic/    -- Anthropic direct API (requires ANTHROPIC_API_KEY)
#   bedrock/      -- AWS Bedrock (requires AWS credentials)
#   azure/        -- Azure OpenAI (requires AZURE_API_KEY, AZURE_API_BASE)
#   vertex_ai/    -- Google Vertex AI (requires GOOGLE_APPLICATION_CREDENTIALS)
#
# Example model identifiers:
#   openai/gpt-4.1                                   -- OpenAI GPT-4.1
#   openai/gpt-4.1-mini                              -- OpenAI GPT-4.1 Mini
#   anthropic/claude-sonnet-4-6                       -- Anthropic Claude Sonnet
#   bedrock/us.anthropic.claude-sonnet-4-5-v2:0       -- AWS Bedrock Claude
#   bedrock/us.amazon.nova-pro-v1:0                   -- AWS Bedrock Nova Pro
#
# =============================================================================

# Executor model (main agent that performs the task)
# MODEL_ID=openai/gpt-4.1
# or equivalently:
# EXECUTOR_MODEL=openai/gpt-4.1

# Scout model (optional -- currently the scout phase is LLM-free)
# SCOUT_MODEL=openai/gpt-4.1-mini

# =============================================================================
# Provider API Keys (set the keys for your chosen provider)
# =============================================================================

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# AWS Bedrock (uses standard AWS credential chain)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# BitGN Harness
# =============================================================================

# BENCHMARK_HOST=https://api.bitgn.com
